# 로컬 개발용 예시 파일. 실제로 nginx가 읽는 파일은 upstream-active.conf(git 비추적)이며, 이
# 파일을 그대로 복사해서 만든다:
#
#   cp nginx/conf.d/upstream-active.conf.example nginx/conf.d/upstream-active.conf
#
# 서버(EC2)에서는 이 파일을 사람이 직접 만들 필요 없다 — 배포 스크립트(.github/workflows/deploy.yml)가
# 최초 배포 시 blue를 기본값으로 자동 생성하고, 이후 배포마다 컷오버 대상 색으로 덮어쓴다.
# docs/architecture/DoctorPet-무중단배포.md 5절 참고.
upstream app_upstream {
    server app-blue:8080;

    # nginx-app 간 커넥션을 재사용해 매 요청마다 TCP 핸드셰이크가 발생하지 않게 한다. keepalive를
    # 쓰려면 상위 location 블록에 proxy_http_version 1.1과 proxy_set_header Connection ""가
    # 함께 있어야 한다(nginx.conf에 이미 설정됨).
    keepalive 16;
}
