# 이 파일을 복사해서 .env로 만들고, 실제 값으로 채워서 사용하세요.
# .env는 .gitignore에 등록돼 있어 커밋되지 않습니다. docker-compose.yml이 이 파일을 읽어
# app 컨테이너의 환경변수로 그대로 주입합니다(env_file).

# Compose 프로젝트 이름을 클론 디렉터리명과 무관하게 고정합니다(재재검토 지적 P2) — 지정하지
# 않으면 Compose가 디렉터리 basename을 프로젝트 이름으로 쓰는데, docker-compose.monitoring.yml이
# 메인 스택의 기본 네트워크를 `doctorpet_default`라는 리터럴 이름으로 참조합니다(networks.
# default.external 참고). 클론 디렉터리명이 `DoctorPet`이 아니면(로컬에서 다른 이름으로 받은
# 경우 등) 메인 프로젝트 이름이 달라져 그 네트워크가 존재하지 않게 되고, 모니터링 스택 기동이
# `network doctorpet_default declared as external, but could not be found`로 실패합니다.
# 이 값을 고정해두면 디렉터리 이름이 무엇이든 항상 doctorpet_default가 만들어집니다(EC2는
# 이미 ~/DoctorPet이라 이 값을 추가해도 기존 프로젝트 이름·컨테이너·볼륨에 변화가 없습니다).
COMPOSE_PROJECT_NAME=doctorpet

# 실행 프로파일 — docker(인프라 검증용, PortOne·SMTP·S3 실연동 없이도 기동)/prod(실제 운영).
# prod로 바꾸기 전에 PAYMENT_GATEWAY=portone, MAIL_PROVIDER=smtp, IMAGE_STORAGE_PROVIDER=s3로
# 실연동 값을 먼저 채우세요 — 안 그러면 ProductionSafetyGuard가 부팅 자체를 막습니다(리뷰 지적 P1/P2).
SPRING_PROFILES_ACTIVE=docker

# MySQL root 비밀번호 — 이 compose 파일이 같이 띄우는 "로컬 mysql 컨테이너"를 초기화할 때만
# 쓰입니다(docker-compose.yml의 mysql 서비스). 로컬 테스트만 할 거면 비워둬도 기본값(root)으로
# 동작하지만, 실제 서버에 배포할 때는 반드시 바꾸세요.
# RDS 등 외부 DB로 전환한 서버에서는 로컬 mysql 컨테이너를 아예 기동하지 않으므로(deploy.yml
# 참고) 이 값은 사실상 쓰이지 않습니다 — RDS 마스터 비밀번호를 여기 넣지 마세요. 앱이 실제로
# 쓰는 자격 증명은 아래 SPRING_DATASOURCE_* 3개이고, 이 변수와는 완전히 분리되어 있습니다
# (RDS PR 재검토 지적 P1 — 예전엔 SPRING_DATASOURCE_PASSWORD가 이 값을 그대로 재사용해서,
# 앱/EC2 환경변수 노출 시 피해 범위가 RDS 마스터 권한까지 확대됐습니다).
MYSQL_ROOT_PASSWORD=change-this-to-a-strong-password

# DB 접속 정보 — 기본값은 이 compose 파일이 같이 띄우는 로컬 mysql 서비스(root/위 MYSQL_ROOT_
# PASSWORD)를 가리키므로, 로컬 개발이나 로컬 mysql을 계속 쓰는 서버라면 아래 세 줄을 그대로
# 주석 처리해두면 됩니다. 단, 로컬에서 MYSQL_ROOT_PASSWORD를 기본값(root)이 아닌 값으로
# 바꿨다면 SPRING_DATASOURCE_PASSWORD도 같은 값으로 채워야 합니다 — 더 이상 자동으로
# 따라가지 않습니다(docker-compose.yml 주석 참고).
#
# RDS 등 외부 MySQL로 전환할 때는 세 줄 모두 채우세요. USERNAME/PASSWORD는 RDS 마스터
# 계정이 아니라 `doctorpet` 스키마 권한만 가진 전용 사용자여야 합니다 — 마스터 계정을 그대로
# 쓰면 앱/EC2 환경변수 노출 시 RDS 인스턴스 전체 관리 권한이 샙니다. 전용 사용자는 마스터
# 계정으로 한 번만 만들면 됩니다(ddl-auto=update라 DML뿐 아니라 스키마 변경 권한도 필요합니다.
# TRIGGER도 필요합니다 — NotificationRecipientMigrationRunner가 최초 1회 CREATE/DROP TRIGGER를
# 실행하며, 기존 RDS는 복원된 덤프에 마커·트리거가 이미 있어 건너뛰지만 신규 환경·백업 복구·
# 향후 다른 트리거 마이그레이션에서는 이 권한이 없으면 부팅이 실패합니다. 재검토 지적 P1):
#   CREATE USER 'doctorpet_app'@'%' IDENTIFIED BY '<강력한-무작위-비밀번호>';
#   GRANT SELECT, INSERT, UPDATE, DELETE, CREATE, ALTER, INDEX, REFERENCES, DROP, TRIGGER
#     ON doctorpet.* TO 'doctorpet_app'@'%';
#   FLUSH PRIVILEGES;
# SPRING_DATASOURCE_URL=jdbc:mysql://<rds-endpoint>:3306/doctorpet?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
# SPRING_DATASOURCE_USERNAME=doctorpet_app
# SPRING_DATASOURCE_PASSWORD=<위에서 만든 doctorpet_app 비밀번호>

# Redis 접속 정보 — DB와 같은 패턴(ElastiCache 이관 준비, 이슈 #163 후속). 기본값은 로컬 redis
# 서비스(인증·TLS 없음)를 가리키므로, 로컬 개발이나 로컬 redis를 계속 쓰는 서버라면 아래 네 줄을
# 그대로 주석 처리해두면 됩니다.
#
# ElastiCache로 전환할 때는 네 줄 모두 채우세요. HOST/PORT는 클러스터 엔드포인트(Redis OSS
# 캐시라면 보통 Primary/Reader 엔드포인트, 클러스터 모드 비활성화 기준), PASSWORD는 콘솔에서
# "전송 중 암호화"를 켰을 때 설정하는 AUTH 토큰입니다(RDS 마스터 비밀번호처럼 절대 커밋되는
# 파일에 넣지 마세요 — EC2 git 비추적 .env에서만 관리). SSL_ENABLED는 전송 중 암호화(TLS) 사용
# 여부에 맞춰 true/false로 설정하세요 — 콘솔 설정과 이 값이 어긋나면 앱이 아예 연결하지 못합니다.
# 이 값들은 Spring Boot의 spring.data.redis.* 표준 프로퍼티에 매핑됩니다(docker-compose.yml
# 주석 참고) — 실제 클러스터 생성 시 콘솔 설정(암호화·AUTH 여부)에 맞춰 값을 확정할 것.
# SPRING_DATA_REDIS_HOST=<elasticache-엔드포인트>
# SPRING_DATA_REDIS_PORT=6379
# SPRING_DATA_REDIS_PASSWORD=<AUTH 토큰, 전송 중 암호화를 켰다면>
# SPRING_DATA_REDIS_SSL_ENABLED=true

# JWT — 운영에서는 반드시 충분히 긴 무작위 값으로 바꾸세요(예: openssl rand -base64 64).
JWT_SECRET=change-this-to-a-long-random-base64-secret-at-least-256-bits
JWT_ACCESS_TOKEN_EXPIRATION=3600000
JWT_REFRESH_TOKEN_EXPIRATION=1209600000

# 결제 게이트웨이 — fake(외부 연동 없음, 운영 금지)/portone(실연동) 중 선택.
PAYMENT_GATEWAY=fake
# 빌링키 암호화 키(AES-256-GCM, Base64 인코딩된 256-bit 랜덤 키). 예: openssl rand -base64 32
PAYMENT_BILLING_KEY_ENC_KEY=change-this-to-a-base64-encoded-256-bit-key
# payment.portone.* — Spring이 OS 환경변수를 자동으로 relaxed binding하므로 접두사
# PAYMENT_PORTONE_이 그대로 필요하다(PORTONE_이 아님).
PAYMENT_PORTONE_BASE_URL=https://api.portone.io
PAYMENT_PORTONE_API_SECRET=change-this-portone-api-secret
PAYMENT_PORTONE_STORE_ID=change-this-store-id

# AI 상담 게이트웨이 — fake(외부 연동 없음, 운영 금지) 외 실연동 구현체는 아직 없음.
AI_GATEWAY=fake

# 이메일 발송 — fake(로그만)/smtp(실제 발송) 중 선택.
MAIL_PROVIDER=fake
MAIL_FROM=noreply@doctorpet.example
MAIL_VERIFICATION_BASE_URL=http://localhost:8080/api/auth/verify-email
MAIL_PASSWORD_RESET_BASE_URL=http://localhost:3000/reset-password
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=587
MAIL_SMTP_USERNAME=change-this-to-your-smtp-username
MAIL_SMTP_PASSWORD=change-this-to-your-smtp-app-password

# 반려동물 프로필 이미지 업로드 — fake(외부 연동 없음, 운영 금지)/s3(실연동) 중 선택.
IMAGE_STORAGE_PROVIDER=fake
IMAGE_STORAGE_S3_BUCKET=change-this-to-your-bucket-name
IMAGE_STORAGE_S3_REGION=ap-northeast-2
# AWS 자격 증명은 여기 두지 않는다 — SDK 기본 체인(컨테이너에 IAM 역할 부여를 권장하며,
# 로컬 docker 테스트만 한다면 AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY를 이 파일에 임시로
# 추가해 쓸 수 있으나 커밋하지 않는다).

# 공공데이터 API — 병원 시드 최초 1회 적재 시에만 true로.
PUBLIC_DATA_SERVICE_KEY=
PUBLIC_DATA_SEED_ENABLED=false

# 기존 회원 email_verified 백필(리뷰 지적 P1) — 배포 첫 실행 시 true로 켜져 있어야 기존
# 회원이 로그인 차단되지 않습니다. 마커(schema_migrations)로 1회만 실행되니 계속 true로
# 둬도 안전합니다.
MEMBER_EMAIL_VERIFIED_BACKFILL_ENABLED=true

HOSPITAL_SEARCH_CACHE_TTL=10m

# Grafana 관리자 비밀번호 — 모니터링 스택(docker-compose.monitoring.yml의 prometheus/grafana
# 서비스, 이슈 #105 후속). Grafana는 127.0.0.1에만 게시되지만(docker-compose.monitoring.yml
# 주석 참고) 그래도 기본값(admin/admin류)을 그대로 두지 말 것.
# 필수값이다(리뷰 지적 P1) — docker-compose.monitoring.yml이 `${GRAFANA_ADMIN_PASSWORD:?...}`로
# 선언돼 있어 이 값이 없으면 Grafana 컨테이너가 아예 기동에 실패한다(공개된 fallback 문자열이
# 실제 admin 비밀번호로 쓰이는 걸 막기 위함). 기존에 이 프로젝트를 이미 배포해둔 EC2가
# 있다면, 이 브랜치를 배포하기 전에 서버의 git 비추적 .env에 반드시 이 값을 먼저 채워야
# 한다 — 다른 비밀값(JWT_SECRET 등)과 동일하게 이 파일도 GitHub Actions가 자동으로
# 채워주지 않고 운영자가 EC2에 직접 관리한다.
# 값을 일부러 비워뒀다(재리뷰 지적 P2) — 이전엔 예시값이 `change-this-to-a-strong-password`
# 였는데, 이 파일을 그대로 복사해 .env로 쓰면 `:?` fail-closed는 통과하면서 저장소에 공개된
# 문자열이 그대로 실제 admin 비밀번호가 되는 모순이 있었다. 빈 값도 `:?`(콜론 포함 형식)엔
# "값 없음"으로 취급돼 동일하게 기동을 막으므로, 맹목적 복사로는 절대 통과할 수 없게 했다.
# 큰따옴표(")나 백슬래시(\)는 값에 넣지 말 것(재재검토 지적 P2-3, 사소) — deploy.yml의
# 비밀번호 회전 검증이 이 값을 curl -K -(stdin 설정 파일)로 넘기는데, 그 포맷은 큰따옴표로
# 감싼 값 안의 이스케이프를 해석한다. 이 두 문자가 들어가면 회전 자체는 grafana-cli로
# 정상 적용되는데 검증 curl만 파싱이 깨져 401로 오판되고, 매 배포마다 불필요하게
# --force-recreate가 반복될 수 있다. openssl rand -base64 32처럼 생성한 값은 이 두 문자를
# 포함하지 않아 안전하다.
GRAFANA_ADMIN_PASSWORD=
