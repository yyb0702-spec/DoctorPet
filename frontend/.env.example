# 복사해서 .env.local 등으로 사용. 실제 비밀값은 커밋 금지.
# npm run dev(실연동)는 이 파일 기준 목 OFF가 기본이어야 하므로 false로 둔다.
# 전체 목 모드가 필요하면 .env.local에서 개별로 true를 주거나 npm run dev:mock(.env.mock)을 쓴다.
VITE_API_BASE_URL=/api
# 운영 예시. 미설정하면 현재 origin의 /ws/chat으로 연결하므로 Vercel 배포에서는 지정해야 한다.
# VITE_CHAT_WS_URL=wss://doctorpet.click/ws/chat
VITE_ENABLE_MOCKS=false
# (선택) dev 프록시 대상 백엔드. 미설정 시 http://localhost:8080
# VITE_PROXY_TARGET=http://localhost:8080
# PortOne 빌링키 발급용(클라이언트 노출 값, 비밀 아님)
# VITE_PORTONE_STORE_ID=store-xxxxxxxx
# VITE_PORTONE_CHANNEL_KEY=channel-key-xxxxxxxx
# 빌링키 원본 직접 입력 UI(개발용) — 기본 꺼짐. 로컬에서 꼭 필요할 때만 true.
VITE_ALLOW_MANUAL_BILLING_KEY=false
