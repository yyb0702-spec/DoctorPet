# npm run dev:mock(vite --mode mock) 전용. 비밀값 없음 — 커밋 가능.
# 백엔드 없이 전체 UI를 MSW로 목 처리한다(README "실연동 vs mock" 참고).
VITE_API_BASE_URL=/api
VITE_ENABLE_MOCKS=true
# demoHandlers까지 얹어 실연동 엔드포인트도 mock으로 가로챈다(browser.ts).
VITE_FULL_MOCK=true
# 이 모드에는 PortOne 상점 설정이 없어 결제창 발급이 비활성화된다 — 결제수단 등록
# 플로우를 테스트하려면 빌링키 직접 입력이 필요하다(PaymentMethodsPage.tsx).
VITE_ALLOW_MANUAL_BILLING_KEY=true
